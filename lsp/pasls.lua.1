-- lsp/pasls.lua
return {
  cmd = {
    "/home/ivan/git/pascal-language-server/server/pasls",
    "--save-log",
    "/tmp/pasls-nvim.log",
  },

  filetypes = {
    "pascal",
  },

  root_markers = {
    ".git",
    "*.lpi",
    "*.lpk",
    "*.lpr",
  },

  mason = false,

  cmd_env = {
    PP = "/usr/bin/ppcx64",
    FPCDIR = "/usr/share/fpcsrc/3.2.2",
    LAZARUSDIR = "/usr/share/lazarus/4.8.0",
    FPCTARGET = "linux",
    FPCTARGETCPU = "x86_64",
  },

  on_init = function(client)
    local provider = client.server_capabilities.completionProvider

    if not provider then
      return
    end

    -- O pasls envia esses campos como JSON null.
    -- O Neovim converte null para vim.NIL (userdata),
    -- mas o completion nativo espera tabelas.
    if type(provider.triggerCharacters) ~= "table" then
      provider.triggerCharacters = {}
    end

    if type(provider.allCommitCharacters) ~= "table" then
      provider.allCommitCharacters = {}
    end
  end,
}
